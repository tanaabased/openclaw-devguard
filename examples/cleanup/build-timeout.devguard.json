{
  "version": 1,
  "plugin": {
    "id": "openclaw-devguard",
    "build": {
      "command": "bash",
      "args": ["examples/cleanup/hang-process-tree.sh", "build"]
    },
    "validate": {
      "command": "bun",
      "args": ["run", "plugin:check"]
    },
    "watch": ["index.ts"]
  },
  "policy": {
    "mode": "probe"
  },
  "logging": {
    "environmentValueAllowlist": []
  },
  "gateway": {
    "port": 19001
  },
  "supervision": {
    "buildTimeoutSeconds": 1,
    "validationTimeoutSeconds": 300,
    "shutdownGraceSeconds": 1
  }
}
