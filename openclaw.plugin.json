{
  "id": "openclaw-devguard",
  "name": "OpenClaw DevGuard",
  "description": "Development-time safety guardrails for OpenClaw plugin work.",
  "version": "0.1.1",
  "activation": {
    "onStartup": true
  },
  "commandAliases": [
    {
      "name": "devguard",
      "kind": "cli"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "logging": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "logPath": {
            "type": "string",
            "minLength": 1
          },
          "environmentValueAllowlist": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
